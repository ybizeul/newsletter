{{ define "newsletter" }}<!doctype html><html><body style="margin:0;padding:0;font-family:'Courier New',Consolas,Menlo,Monaco,'Liberation Mono','DejaVu Sans Mono',monospace;line-height:2;color:#111111;font-size:16px;">
<style>
.newsletter-bare,
.newsletter-bare * {
	font-family: ui-monospace,SFMono-Regular,Consolas,'Liberation Mono',Menlo,monospace !important;
	line-height: 1.5 !important;
	margin-bottom: 1em !important;
}
</style>
<div class="newsletter-bare">
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse;margin:0;padding:0;">
<tr><td align="center" style="padding:24px 20px;">
<!--[if mso]><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="{{ .ContentWidth }}" align="center" style="border-collapse:collapse;"><tr><td width="{{ .ContentWidth }}" style="width:{{ .ContentWidth }}px;"><![endif]-->
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" align="center" style="width:100%;max-width:{{ .ContentWidth }}px;border-collapse:collapse;margin:0 auto;">
<tr><td style="padding:0;text-align:left;word-break:break-word;overflow-wrap:anywhere;font-family:ui-monospace,SFMono-Regular,Consolas,'Liberation Mono',Menlo,monospace;">
{{ if .HeaderHTML }}<div style="margin:0 0 16px;">{{ safeHTML .HeaderHTML }}</div>
{{ end }}<div style="margin:0 0 20px;">{{ safeHTML .IntroHTML }}</div>
{{ if and .IncludeIndex (gt (len .Articles) 0) }}{{ template "index" .Articles }}{{ end }}{{ range .Articles }}{{ template "article" . }}{{ end }}{{ if .FooterHTML }}<div style="margin:20px 0 0;">{{ safeHTML .FooterHTML }}</div>
{{ end }}</td></tr></table>
<!--[if mso]></td></tr></table><![endif]-->
</td></tr></table></div></body></html>{{ end }}